// Prisma schema for SlideShelf
// Relational schema for Users, Courses, and Slides.
// By default configured for SQLite for zero-friction local development (file:./dev.db).
// For PostgreSQL production deployment (e.g. Neon, Supabase, RDS),
// simply switch provider to "postgresql" or use prisma/schema.postgresql.prisma.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // "STUDENT" | "COURSE_REP"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  slides       Slide[]  @relation("UploadedBy")

  @@map("users")
}

model Course {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "CS 201"
  title     String           // e.g. "Data Structures"
  level     Int              // 100, 200, 300, 400
  semester  Int              // 1, 2
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slides    Slide[]

  @@index([level, semester])
  @@map("courses")
}

model Slide {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String   // e.g. "Arrays & Linked Lists"
  week          Int      // e.g. 1
  fileName      String   // e.g. "week-01-arrays.pdf"
  fileType      String   // "PDF", "PPT", "PPTX"
  fileSize      String   // e.g. "2.4 MB"
  fileSizeBytes Int      // file size in bytes
  storagePath   String   // Storage object key (GCS or local driver)
  uploadedById  String
  uploadedBy    User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId, week])
  @@map("slides")
}
