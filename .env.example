# =========================================================
# SlideShelf — Supabase Environment Configuration
# =========================================================

# 1. Supabase Project Settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Service Role Key (Project Settings -> API -> Project API Keys -> service_role secret)
# IMPORTANT: Keep this secret server-side only. Never expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Supabase PostgreSQL Connection String (Project Settings -> Database -> Connection String -> URI)
# Choose "Transaction pooler" (port 6543) or "Session pooler" (port 5432)
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 3. Session & Authentication Secret (Generate 32+ random characters)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"

# 4. Storage Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="lecture-slides"

# 5. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
